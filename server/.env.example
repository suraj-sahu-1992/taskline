# HTTP port for the backend API; match the frontend API URL.
PORT=8000
# MongoDB connection string for persistent task data; keep credentials out of Git.
MONGODB_URI=mongodb://127.0.0.1:27017/task_manager
# Comma-separated browser origins allowed to call the API (exact scheme, host, and port).
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Runtime mode: development, test, or production. Public errors never expose stack traces.
NODE_ENV=development
# Maximum API requests per IP per minute for this single server process.
RATE_LIMIT_MAX=300
